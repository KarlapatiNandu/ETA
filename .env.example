# Bus Mitra — every environment variable, documented.
# Copy to .env for local dev. Values below are the local-stack defaults; none are secrets
# except where marked SECRET. `pnpm env:check` validates this file before `pnpm dev` boots.

# ── core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# The one operating timezone. Stored data is always UTC; this is for service_date maths.
TZ_OPERATING=Asia/Kolkata

# ── Supabase (local: printed by `supabase status` after `pnpm dev`) ─────────
SUPABASE_URL=http://127.0.0.1:54321
# Local anon/service keys are printed by `supabase status`. SECRET in production.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT signing secret used to verify access tokens in the gateway. SECRET.
# Local default from `supabase status`; production from the Supabase dashboard → API.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── geo services (docker-compose.dev.yml) ───────────────────────────────────
# car: route matching (gateway) and free-flow speeds for ETAs (engine; optional there).
# foot: walking times from a student's home pin (gateway). Photon: area search when the
# text is a place rather than a stop (gateway). Not secret. Production: the OSRM/tiles box.
OSRM_CAR_URL=http://127.0.0.1:5000
OSRM_FOOT_URL=http://127.0.0.1:5001
PHOTON_URL=http://127.0.0.1:2322
TILES_URL=http://127.0.0.1:8080

# ── SMS ─────────────────────────────────────────────────────────────────────
# console = OTPs are printed to the gateway log (dev). msg91 = real SMS (needs DLT approval).
SMS_PROVIDER=console
# MSG91 dashboard → API. SECRET. Required only when SMS_PROVIDER=msg91.
# MSG91_AUTH_KEY=
# 6-character DLT-registered sender header.
# MSG91_SENDER_ID=BUSMTR
# MSG91 Flow/template id for the OTP message (DLT-approved template).
# MSG91_TEMPLATE_OTP=
# MSG91 Flow/template ids for the T0 CRITICAL and T1 URGENT alerts (DLT-approved; variables
# ##title## and ##body##). Unset = that alert cannot go by SMS until DLT approves it.
# MSG91_TEMPLATE_T0=
# MSG91_TEMPLATE_T1=
# Shared secret in the MSG91 delivery-receipt webhook URL:
#   <gateway>/v1/notify/sms-receipt?token=<this>. SECRET. Generate: openssl rand -hex 16
# SMS_RECEIPT_TOKEN=

# ── push (Stage 6) ──────────────────────────────────────────────────────────
# VAPID key pair for Web Push. Optional in dev (without it, push is off and T0/T1 fall back to
# SMS). Generate once: pnpm --filter @busmitra/notify vapid. The private key is a SECRET;
# rotating the pair invalidates every browser subscription (students re-enable alerts).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact the push services require (mailto: or https:).
VAPID_SUBJECT=mailto:transport@busmitra.invalid

# ── gateway ─────────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
# Origin of the student/admin web app, for CORS.
WEB_ORIGIN=http://localhost:3000
# Origin of the driver PWA (apps/driver), for CORS and the pairing links the tracker CLI prints.
DRIVER_ORIGIN=http://localhost:5173
# HMAC key that derives the decoy masked phone shown for unknown roll numbers. SECRET.
# Generate: openssl rand -hex 32
CLAIM_DECOY_KEY=dev-only-decoy-key-change-me-0123456789abcdef
# pgp_sym_encrypt key for trackers.secret_enc. Never stored in the database. SECRET.
# Generate: openssl rand -hex 32
TRACKER_SECRET_KEY=dev-only-tracker-key-change-me-0123456789abcdef

# ── web (Next.js public vars — mirror the Supabase values above) ────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
# Tile server for the admin route editor's map (tileserver-gl, ADR-0005).
NEXT_PUBLIC_TILES_URL=http://localhost:8080

# ── driver PWA (Vite public vars; apps/driver) ──────────────────────────────
# The gateway the phone talks to. Must be reachable from the phone, not just the laptop:
# for a real-device test on the LAN use the laptop's IP, e.g. http://192.168.1.20:4000
VITE_GATEWAY_URL=http://localhost:4000
