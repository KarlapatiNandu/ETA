# Shared by infra/osrm/prepare.sh and infra/tiles/prepare.sh so routing and tiles cover
# exactly the same area. Hyderabad metro incl. CBIT (Gandipet) with a margin for
# outlying bus routes. minlon,minlat,maxlon,maxlat
HYD_BBOX=78.15,17.15,78.80,17.70
# Telangana-only extract (~100 MB) from the OpenStreetMap France mirror. Geofabrik publishes
# no per-state India file (only six zones; southern-zone is ~560 MB) and throttled to ~160 B/s
# from the build machine on 2026-09-22. Fallback if this mirror is down:
#   https://download.geofabrik.de/asia/india/southern-zone-latest.osm.pbf
OSM_SOURCE_URL=https://download.openstreetmap.fr/extracts/asia/india/telangana-latest.osm.pbf
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v5.27.1
PLANETILER_IMAGE=ghcr.io/onthegomap/planetiler:0.9.1
