* [0-9]
* [0-9].*
# k6 load-run output: minted tokens, throwaway certs, logs (apps/simulator/src/load/run.ts)
tests/load/.run/
# Vite dependency pre-bundle cache
**/.vite/
# restore-drill working directory (infra/scripts/restore-drill.sh)
.restore-drill.*/
